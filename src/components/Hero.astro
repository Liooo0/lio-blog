---
import { SITE } from '../consts';
---

<section class="pt-16 sm:pt-28 pb-20 sm:pb-32 border-b border-surface-200/80">
  <div class="flex flex-col items-start max-w-4xl">
    <!-- Status / Workshop pill -->
    <div class="inline-flex flex-wrap items-center gap-2 sm:gap-2.5 px-3 py-1 rounded-full border border-surface-300/80 bg-surface-100/80 font-mono text-[10px] sm:text-[11px] text-surface-600 tracking-wider mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-accent-600 animate-pulse"></span>
      <span class="font-bold text-surface-900">LIO WORKSHOP</span>
      <span class="text-surface-300">/</span>
      <span>2026 ARCHIVE</span>
      <span class="text-surface-300 hidden sm:inline">/</span>
      <span class="hidden sm:inline">SHENZHEN · CN</span>
    </div>

    <!-- Monumental Headline -->
    <h1 class="font-serif font-black text-5xl sm:text-7xl lg:text-8xl leading-[1.04] tracking-tight text-surface-950">
      Building things<br />
      worth keeping<i class="not-italic text-accent-600">.</i>
    </h1>

    <!-- Precision Subtitle -->
    <p class="mt-8 text-xl sm:text-2xl text-surface-700 font-sans font-light tracking-wide leading-relaxed max-w-2xl">
      全栈 AI 工程 · 自动化工作流 · 真实场景下的自研工具
    </p>

    <!-- Narrative Bridge -->
    <div class="mt-8 p-5 border-l-2 border-accent-600 bg-surface-100/50 max-w-2xl font-sans text-sm sm:text-base text-surface-700 leading-relaxed">
      信奉<strong>「自己遇到问题 → 自己造工具 → 生产环境自用 → 持续迭代打磨」</strong>。<br />
      不列虚高指标，只记真正交付过的工程、跑出来的实测数据与真实生活切片。
    </div>

    <!-- Quick Navigation Anchors (Grid on mobile, flex on desktop) -->
    <nav class="mt-12 w-full sm:w-auto grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2.5 sm:gap-4 font-mono text-xs tracking-wider" aria-label="章节快捷导航">
      <a href="#projects" class="group flex items-center justify-center sm:justify-start gap-2 px-3 sm:px-4 py-2.5 border border-surface-300/90 bg-surface-100/50 hover:bg-surface-950 hover:text-surface-50 hover:border-surface-950 transition-all text-center sm:text-left">
        <span class="text-accent-600 group-hover:text-accent-400 font-bold">01</span>
        <span class="truncate">PROJECTS ↓</span>
      </a>
      <a href="#writing" class="group flex items-center justify-center sm:justify-start gap-2 px-3 sm:px-4 py-2.5 border border-surface-300/90 bg-surface-100/50 hover:bg-surface-950 hover:text-surface-50 hover:border-surface-950 transition-all text-center sm:text-left">
        <span class="text-accent-600 group-hover:text-accent-400 font-bold">02</span>
        <span class="truncate">WRITING ↓</span>
      </a>
      <a href="#now" class="group flex items-center justify-center sm:justify-start gap-2 px-3 sm:px-4 py-2.5 border border-surface-300/90 bg-surface-100/50 hover:bg-surface-950 hover:text-surface-50 hover:border-surface-950 transition-all text-center sm:text-left">
        <span class="text-accent-600 group-hover:text-accent-400 font-bold">03</span>
        <span class="truncate">NOW ↓</span>
      </a>
      <a href="#about" class="group flex items-center justify-center sm:justify-start gap-2 px-3 sm:px-4 py-2.5 border border-surface-300/90 bg-surface-100/50 hover:bg-surface-950 hover:text-surface-50 hover:border-surface-950 transition-all text-center sm:text-left">
        <span class="text-accent-600 group-hover:text-accent-400 font-bold">04</span>
        <span class="truncate">ABOUT ↓</span>
      </a>
    </nav>
  </div>
</section>
