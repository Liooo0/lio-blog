---
import { SITE, SOCIAL } from '../consts';

const photoSiteUrl = SOCIAL.photography;

// ── Direction 3 · Darkroom Film Strip（V5.6，2026-10-17；真实 EXIF 补于 2026-10-18）──
// 3 帧接触印相（contact sheet）：FRAME 01A / 02A / 03A。
// 参数口径（只写有可核来源的值）：
// · FRAME 01A 取 best2025.jpg 原片 EXIF（hero 图由其降采样导出）：
//   Panasonic S5M2 + LUMIX S 20-60mm F3.5-5.6 · f/3.5 · 10s · ISO640 · 20mm。
// · FRAME 02A 各副本（作品集 / 备份）EXIF 已在后期导出环节剥离、无 RAW 留存，
//   曝光参数保持「—」并由模板条件渲染，不编数字。
// · FRAME 03A 为 LEADER 空帧，留给下一卷。
const frames = [
	{
		no: '01A',
		img: `${SITE.base}/photography/hero.webp`,
		alt: 'SHENZHEN BAY — 海岸线与天空',
		place: 'SHENZHEN BAY',
		body: 'PANASONIC LUMIX S5M2',
		lens: 'LUMIX S 20-60MM F3.5-5.6',
		aperture: '3.5',
		shutter: '10s',
		iso: '640',
		note: '天亮前到海边，等第一束光。',
	},
	{
		no: '02A',
		img: `${SITE.base}/photography/star.webp`,
		alt: 'MOUNTAIN NIGHT — 夜空与星野',
		place: 'MOUNTAIN NIGHT',
		body: 'PANASONIC LUMIX S5M2',
		lens: '—',
		aperture: '—',
		shutter: '—',
		iso: '—',
		note: '深夜的山里，抬头就是星野。',
	},
];
---
<!-- 摄影：留住那些“我出去是为了看见它”的瞬间 -->
<section id="photography" class="py-16 md:py-24 border-t border-surface-200 dark:border-surface-900">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="text-[13px] font-mono text-surface-500 tracking-widest uppercase mb-3">Photography</h2>
        <p class="text-surface-700 dark:text-surface-300 text-[15px] leading-relaxed">
          Things I went outside to see.
        </p>
      </div>
      <a href={photoSiteUrl} class="text-[12px] font-mono text-accent-600 dark:text-accent-500 hover:underline tracking-wider" target="_blank" rel="noopener">
        作品站 ↗
      </a>
    </div>

    <!-- Darkroom Film Strip -->
    <div class="border border-surface-300/80 dark:border-surface-800/80 rounded-lg overflow-hidden bg-surface-950">
      <!-- Film header: stock / body roll label -->
      <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-3 border-b border-surface-800 font-mono text-[10.5px] tracking-wider text-surface-400">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="font-bold text-surface-200 flex-none">KODAK 400TX</span>
          <span class="text-surface-600 flex-none">·</span>
          <span class="truncate">SHENZHEN</span>
          <span class="text-surface-600 flex-none hidden sm:inline">·</span>
          <span class="hidden sm:inline flex-none">PANASONIC LUMIX S5M2</span>
        </div>
        <div class="text-surface-500 flex-none hidden sm:block">CONTACT SHEET · ROLL 03</div>
      </div>

      <!-- Frames -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-surface-800">
        {frames.map((f) => (
          <figure class="relative bg-surface-950">
            <div class="relative overflow-hidden">
              <img
                src={f.img}
                alt={f.alt}
                class="w-full h-[230px] sm:h-[300px] object-cover opacity-90 hover:opacity-100 hover:scale-[1.03] transition-all duration-700"
                loading="lazy"
              />
              <span class="absolute top-2 left-2 font-mono text-[10px] tracking-widest text-surface-100 bg-surface-950/75 px-1.5 py-0.5 rounded-sm">
                FRAME {f.no}
              </span>
            </div>
            <figcaption class="px-3.5 py-3 border-t border-surface-800 font-mono text-[10.5px] leading-relaxed">
              <div class="flex items-center justify-between gap-2">
                <span class="font-bold text-surface-200 tracking-wider truncate">{f.place}</span>
                <span class="text-surface-500 flex-none">{f.body}</span>
              </div>
              {(f.lens !== '—' || f.aperture !== '—' || f.shutter !== '—' || f.iso !== '—') && (
                <div class="mt-1 flex flex-wrap gap-x-3 gap-y-0.5 text-surface-500">
                  {f.lens !== '—' && <span>LENS {f.lens}</span>}
                  {f.aperture !== '—' && <span>F {f.aperture}</span>}
                  {f.shutter !== '—' && <span>{f.shutter}</span>}
                  {f.iso !== '—' && <span>ISO {f.iso}</span>}
                </div>
              )}
              <div class="mt-1.5 text-surface-400">{f.note}</div>
            </figcaption>
          </figure>
        ))}

        <!-- FRAME 03A: leader frame（下一卷留白） -->
        <figure class="relative bg-surface-950">
          <div class="relative h-[230px] sm:h-[300px] overflow-hidden flex items-center justify-center">
            <div class="text-center font-mono text-[10.5px] text-surface-600 tracking-widest space-y-1.5">
              <div class="text-[18px] text-surface-700">◍</div>
              <div>LEADER</div>
              <div class="text-surface-700">NEXT ROLL — RESERVED</div>
            </div>
          </div>
          <figcaption class="px-3.5 py-3 border-t border-surface-800 font-mono text-[10.5px] text-surface-600 leading-relaxed">
            <div class="flex items-center justify-between gap-2">
              <span class="tracking-wider">FRAME 03A</span>
              <span>—</span>
            </div>
            <div class="mt-1">胶片引带头。下一批照片冲印后补齐。</div>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
