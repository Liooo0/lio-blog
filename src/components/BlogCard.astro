---
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags: string[];
}

const { title, description, date, slug, tags } = Astro.props;
const mmdd = `${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
---

<a href={`${SITE.base}/blog/${slug}`} class="toc-row group block">
  <time datetime={date.toISOString()}>{mmdd}</time>
  <div>
    <h3 class="group-hover:text-accent-600">{title}</h3>
    <p>{description}</p>
    {tags.length > 0 && (
      <div class="tags">{tags.join(' · ')}</div>
    )}
  </div>
</a>
