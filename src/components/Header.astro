---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname;
const BASE = SITE.base;

function isOn(href: string): boolean {
  if (href === `${BASE}/`) return path === `${BASE}/`;
  return path.startsWith(href);
}
---

<header class="mx-auto w-full max-w-[760px] px-6">
  <div class="toprule">
    <a href={`${BASE}/`} class="brand" aria-label="lio 首页">
      lio<i>.</i>
    </a>
    <nav aria-label="主导航">
      {NAV.map((item, idx) => (
        <span class="flex items-center">
          {idx > 0 && <span class="sep" aria-hidden="true">/</span>}
          <a href={item.href} class={isOn(item.href) ? 'on' : ''}>{item.title}</a>
        </span>
      ))}
    </nav>
  </div>
</header>
