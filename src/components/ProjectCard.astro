---
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tech: string[];
  status: 'completed' | 'in-progress' | 'planned';
  repo?: string;
  demo?: string;
}

const { title, description, date, slug, tech, status, repo, demo } = Astro.props;

const statusText = {
  completed: '已完成',
  'in-progress': '进行中',
  planned: '计划中',
} as const;

const statusColor = {
  completed: 'text-surface-600',
  'in-progress': 'text-accent-600',
  planned: 'text-surface-400',
} as const;

const yyyymm = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;
---

<article class="proj-row">
  <a href={`${SITE.base}/projects/${slug}`} class="block group">
    <div class="flex items-baseline justify-between gap-3">
      <span class="name group-hover:text-accent-600 transition-colors">{title}</span>
      <span class={`meta flex-none ${statusColor[status]}`}>{statusText[status]} · {yyyymm}</span>
    </div>
    <p class="desc">{description}</p>
    <div class="flex items-center justify-between">
      {tech.length > 0 && <div class="meta">{tech.join(' / ')}</div>}
      {(repo || demo) && (
        <div class="flex items-center gap-4 text-[11px] font-mono text-surface-400">
          {repo && <a href={repo} target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 transition-colors">源码 ↗</a>}
          {demo && <a href={demo} target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 transition-colors">演示 ↗</a>}
        </div>
      )}
    </div>
  </a>
</article>
