---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectSpotlight from '../components/ProjectSpotlight.astro';
import WritingPreview from '../components/WritingPreview.astro';
import NowSection from '../components/NowSection.astro';
import PhotographyPreview from '../components/PhotographyPreview.astro';
import AboutPreview from '../components/AboutPreview.astro';
import { HOME } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recentPosts = posts.slice(0, HOME.recentPostsCount);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured && p.data.status !== 'planned')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const total = posts.length;
---

<BaseLayout title={HOME.greeting} wide={true}>
  <Hero />
  <ProjectSpotlight projects={featuredProjects} totalProjects={allProjects.length} />
  <WritingPreview posts={recentPosts} total={total} />
  <NowSection />
  <PhotographyPreview />
  <AboutPreview />
</BaseLayout>
